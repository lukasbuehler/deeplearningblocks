# Copy to .env.local for local builds, or set these as Cloudflare BUILD variables.
# This public token is intentionally included in the browser build. Never use a personal API key.
POSTHOG_PROJECT_TOKEN=
POSTHOG_API_HOST=https://eu.i.posthog.com
# For a US project: https://us.i.posthog.com

# Optional override for config/site.json. An empty value disables indexing.
# SITE_URL=https://deeplearningblocks.com
# Optional for custom preview builds: SITE_PREVIEW=1
# Optional if the Cloudflare production branch differs: SITE_PRODUCTION_BRANCH=main
