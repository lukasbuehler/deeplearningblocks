{
  "name": "deeplearningblocks",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve --watch --configuration development",
    "test": "ng test",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:core": "node --import tsx --test src/app/learning/*.test.ts src/app/playground/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" angular.json package.json wrangler.jsonc",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" angular.json package.json wrangler.jsonc",
    "prebuild": "node scripts/analytics-config.mjs",
    "prestart": "node scripts/analytics-config.mjs",
    "predev": "node scripts/analytics-config.mjs",
    "prewatch": "node scripts/analytics-config.mjs",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:config": "node --test scripts/*.test.mjs",
    "postbuild": "node scripts/build-site.mjs",
    "icons:optimize": ".venv/bin/python3 scripts/optimize_icons.py"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.8",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "posthog-js": "^1.447.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.33",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "piscina": "5.3.2"
  }
}
